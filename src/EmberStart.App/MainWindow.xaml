<Window x:Class="EmberStart.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        mc:Ignorable="d"
        Title="Ember Start"
        Width="704"
        Height="640"
        MinWidth="420"
        MinHeight="360"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource CanvasBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        automation:AutomationProperties.Name="Ember Start"
        PreviewKeyDown="OnPreviewKeyDown"
        Deactivated="OnDeactivated">
    <Border BorderBrush="{StaticResource OutlineStrongBrush}"
            BorderThickness="1"
            Background="{StaticResource CanvasBrush}"
            Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MinHeight="40" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{StaticResource AccentBrush}" CornerRadius="2" />
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="EMBER START" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="PHASE 1 · SHELL CATALOG PREVIEW"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12" />
                </StackPanel>
            </Grid>

            <TextBox x:Name="SearchBox"
                     Grid.Row="1"
                     Margin="0,0,0,12"
                     Style="{StaticResource EmberSearchBox}"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     automation:AutomationProperties.Name="Search installed apps" />

            <ListBox x:Name="ResultsList"
                     Grid.Row="2"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="{StaticResource TextPrimaryBrush}"
                     ItemsSource="{Binding Results}"
                     ItemContainerStyle="{StaticResource EmberListItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     MouseDoubleClick="OnResultsMouseDoubleClick"
                     automation:AutomationProperties.Name="Installed apps">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid MinHeight="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource AccentBrush}" CornerRadius="1" />
                            <Border Grid.Column="1"
                                    Width="28"
                                    Height="28"
                                    Margin="6,0"
                                    Background="{StaticResource SurfaceRaisedBrush}"
                                    CornerRadius="2">
                                <TextBlock Text="•"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontSize="20"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <Image Grid.Column="1"
                                   Width="28"
                                   Height="28"
                                   Margin="6,0"
                                   Source="{Binding Icon}"
                                   Stretch="Uniform" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding DisplayName}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Grid Grid.Row="3" MinHeight="48" Margin="0,12,0,0">
                <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" />
                <TextBlock Text="{Binding StatusText}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           automation:AutomationProperties.LiveSetting="Polite" />
            </Grid>
        </Grid>
    </Border>
</Window>
